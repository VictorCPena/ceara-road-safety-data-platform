FROM eclipse-temurin:17-jre-jammy AS java-runtime

FROM apache/airflow:3.3.2-python3.12
USER root
COPY --from=java-runtime /opt/java/openjdk /opt/java/openjdk
RUN mkdir -p /opt/airflow/runtime /app/work /opt/airflow/dags \
    && chown -R airflow:root /opt/airflow/runtime /app
USER airflow
COPY --chown=airflow:root requirements-airflow-runtime.txt /tmp/requirements-airflow-runtime.txt
RUN python -m venv /opt/airflow/project-venv \
    && /opt/airflow/project-venv/bin/pip install --no-cache-dir -r /tmp/requirements-airflow-runtime.txt \
    && /opt/airflow/project-venv/bin/pip check \
    && python -c "from airflow.providers.standard.operators.bash import BashOperator; import psycopg2"
WORKDIR /app
COPY --chown=airflow:root lakehouse ./lakehouse
COPY --chown=airflow:root dbt_lakehouse ./dbt_lakehouse
COPY --chown=airflow:root scripts ./scripts
ENV JAVA_HOME=/opt/java/openjdk \
    PATH=/opt/java/openjdk/bin:$PATH \
    PYTHONPATH=/app \
    TZ=UTC \
    SPARK_LOCAL_IP=127.0.0.1 \
    PYSPARK_PYTHON=/opt/airflow/project-venv/bin/python \
    PYSPARK_DRIVER_PYTHON=/opt/airflow/project-venv/bin/python \
    DBT_SEND_ANONYMOUS_USAGE_STATS=false \
    DO_NOT_TRACK=true
